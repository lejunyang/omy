<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.omy.testeditor">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />
  <application android:debuggable="true" android:label="omy test editor" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".EditorActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.EDIT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>
  </application>
</manifest>
