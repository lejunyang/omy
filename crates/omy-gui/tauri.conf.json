{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omy",
  "version": "0.0.1",
  "identifier": "org.omy.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "omy",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "img-src": "'self' omystream: http://omystream.localhost data:",
        "media-src": "'self' omystream: http://omystream.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' omystream: http://omystream.localhost ipc: http://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "vendor-ffmpeg/": "ffmpeg/"
    }
  }
}
