{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omy",
  "version": "0.1.0",
  "identifier": "org.omy.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "img-src": "'self' omystream: http://omystream.localhost data:",
        "media-src": "'self' omystream: http://omystream.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' omystream: http://omystream.localhost ipc: http://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
