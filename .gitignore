# Rust
/target/
**/*.rs.bk
*.pdb

# Python（参考实现）
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/

# 前端 / Tauri
node_modules/
dist/
dist-ssr/
.vite/
src-tauri/target/
# 例外：spike 的前端页面是手写源码，不是构建产物，必须入库
!/spikes/webview-range/dist/
!/spikes/webview-range/dist/**
# 例外：GUI 的 dist/ 同样是手写源码（无打包步骤，运行时直接读取），
# 若被上面的 dist/ 规则吞掉，应用启动就是一片空白
!/crates/omy-gui/dist/
!/crates/omy-gui/dist/**

# 开发期工具（便携版 ffmpeg 等，体积大且可脚本重建）
/tools/

# spike 的测试素材（视频与加密样本，可由 make-fixture.ps1 重建）
/spikes/fixtures/

# tauri-build 自动生成的 ACL schema，每次构建重新产出
/spikes/**/gen/schemas/
/crates/**/gen/schemas/

# 一次性调试与改文件脚本（用完即弃，不代表可复用的验证能力）
/spikes/peek-tail.ps1
/spikes/precommit-check.ps1
/spikes/probe-vault-salt.ps1
/spikes/probe-header-layout.ps1
/spikes/probe-verify-ctx.ps1
/spikes/probe-vault-flag.ps1
/spikes/fix-*.ps1
/spikes/update-progress*.ps1
/spikes/check-progress.ps1

# 编辑器与操作系统
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 构建与临时产物
/build/
*.log
*.tmp

# 临时探查脚本与跨实现验证的样本目录（下划线前缀约定为临时文件）
/_*.ps1
/_*.py
/_*.txt
/_xsamples/

# 本项目加密产物（避免误提交测试用的加密文件）
*.omy
*.omy.[0-9][0-9][0-9]

# 密钥与凭据（绝不入库）
*.key
*.pem
secrets.toml
.env
.env.*
!.env.example
