# Rust
/target/
**/*.rs.bk
*.pdb

# Python（参考实现）
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/

# 前端 / Tauri
node_modules/
dist/
dist-ssr/
.vite/
src-tauri/target/
# 例外：spike 的前端页面是手写源码，不是构建产物，必须入库
!/spikes/webview-range/dist/
!/spikes/webview-range/dist/**
# 注意：GUI 的 dist/ 现在是 Vite 的构建产物（源码在 crates/omy-gui/frontend/），
# 所以**不再入库**——产物入库会让每次改前端都在 diff 里混进压缩后的 JS。
# build.rs 会在产物缺失时自动构建，全新 clone 后 `cargo run -p omy-gui` 直接可用。

# 开发期工具（便携版 ffmpeg 等，体积大且可脚本重建）
/tools/

# spike 的测试素材（视频与加密样本，可由 make-fixture.ps1 重建）
/spikes/fixtures/

# tauri-build 自动生成的 ACL schema，每次构建重新产出
/spikes/**/gen/schemas/
/crates/**/gen/schemas/

# 一次性调试与改文件脚本（用完即弃，不代表可复用的验证能力）
